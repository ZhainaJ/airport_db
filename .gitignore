# ============================================================================
# PROJECT: Airport Operations & Passenger Booking Database System
# FILE: .gitignore
# DESCRIPTION: Prevents tracking of local caches, system logs, and IDE metadata
# ============================================================================

# ----------------------------------------------------------------------------
# 1. OPERATING SYSTEM LEAK PROTECTION
# ----------------------------------------------------------------------------
# macOS files
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk

# ----------------------------------------------------------------------------
# 2. IDE & TEXT EDITOR CONFIGURATIONS (Personal Workspace Paths)
# ----------------------------------------------------------------------------
# JetBrains (DataGrip, PyCharm, IntelliJ, etc.)
.idea/
*.iws

# Visual Studio Code
.vscode/
!.vscode/extensions.json
.history/
*.code-workspace

# ----------------------------------------------------------------------------
# 3. DATABASE ENGINE CACHES, LOGS, & TEMPORARY BACKUPS
# ----------------------------------------------------------------------------
# PostgreSQL local session logs and runtime dumps
*.log
*.bak
*.backup
*.sql.bak
.pgpass

# Local data storage directories if using containerized/Docker database volumes
pgdata/
postgres-data/

# ----------------------------------------------------------------------------
# 4. PYTHON, JUPYTER, & DATA SCIENCE RUNTIMES (If applicable)
# ----------------------------------------------------------------------------
# Python compilation bytecode
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook local state checkpoints
.ipynb_checkpoints/

# Virtual environments
venv/
env/
.env
.venv
ENV/

# ----------------------------------------------------------------------------
# 5. SECURITY & ENVIRONMENT CREDENTIALS
# ----------------------------------------------------------------------------
# Never track API keys, local ports, or DB passwords
.env*
!.env.example
